{
  "capabilities": {
    "extensions": [
      {
        "description": "Two-Step Cross-Application Access execution parameters. Step 1: RFC 8693 Token Exchange prerequisite. Step 2: RFC 7523 JWT Bearer Grant.",
        "params": {
          "ref": {
            "flow": "clientCredentials",
            "scheme": "oauth2"
          },
          "tokenEndpointAuthMethod": "private_key_jwt",
          "tokenExchange": {
            "audience": "https://your-org.okta.com/oauth2/aussu3akcsQeofA0C1d7",
            "grantType": "urn:ietf:params:oauth:grant-type:token-exchange",
            "requestedTokenType": "urn:ietf:params:oauth:token-type:id-jag",
            "trustedIssuer": "https://your-org.oktapreview.com"
          },
          "tokenRequest": {
            "audience": "https://app.datarobot.com/dr_org_id/my_agent_id",
            "grantType": "urn:ietf:params:oauth:grant-type:jwt-bearer"
          }
        },
        "uri": "urn:ietf:params:oauth:grant-type:jwt-bearer"
      },
      {
        "description": "Internal DataRobot routing and system identifiers.",
        "params": {
          "deployment_id": "dep-abc123"
        },
        "required": true,
        "uri": "urn:datarobot:agent:identity:internal"
      },
      {
        "description": "Customer-provided external agent identifiers for catalog discovery.",
        "params": {
          "id": "catalog-id-xyz"
        },
        "required": false,
        "uri": "urn:datarobot:agent:identity:external"
      }
    ],
    "pushNotifications": false,
    "streaming": true
  },
  "defaultInputModes": [
    "text",
    "text/plain"
  ],
  "defaultOutputModes": [
    "text",
    "text/plain"
  ],
  "description": "Every card feature turned on",
  "name": "Full Agent",
  "preferredTransport": "JSONRPC",
  "protocolVersion": "0.3.0",
  "security": [
    {
      "oauth2": [
        "agent:read",
        "agent:write",
        "agent:invoke"
      ]
    }
  ],
  "securitySchemes": {
    "oauth2": {
      "description": "OAuth 2.0 authorization utilizing RFC 7523 JWT Bearer Grant. Requires a prerequisite identity assertion via RFC 8693 Token Exchange. Refer to the capabilities.extensions block for strict execution parameters and routing.",
      "flows": {
        "authorizationCode": {
          "authorizationUrl": "https://issuer.example.com/oauth2/default/oauth/authorize",
          "scopes": {
            "agent:read": "Permission: agent:read",
            "agent:write": "Permission: agent:write"
          },
          "tokenUrl": "https://issuer.example.com/oauth2/default/oauth/token"
        },
        "clientCredentials": {
          "scopes": {
            "agent:invoke": "Permission: agent:invoke",
            "agent:write": "Permission: agent:write"
          },
          "tokenUrl": "https://your-org.okta.com/oauth2/aussu3akcsQeofA0C1d7/v1/token"
        }
      },
      "type": "oauth2"
    }
  },
  "skills": [
    {
      "description": "Summarizes text",
      "examples": [
        "Summarize this article"
      ],
      "id": "summarize",
      "name": "Summarize",
      "tags": [
        "text",
        "nlp"
      ]
    },
    {
      "description": "Translates text",
      "id": "translate",
      "name": "Translate",
      "tags": []
    }
  ],
  "supportsAuthenticatedExtendedCard": true,
  "url": "https://app.datarobot.com/api/v2/deployments/dep-abc123/directAccess/a2a/",
  "version": "2.1.0"
}
